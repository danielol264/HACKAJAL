# =========================================================
# HackaJal: configuración única de todo el proyecto
# La leen el backend, la app de escritorio, el portal web y el modelo.
# Copia este archivo como .env y llena los valores.
# =========================================================

# ---------- Base de datos (backend) ----------
DB_NAME=hackajal
DB_USER=hackajal_user
DB_PASSWORD=cambia_esta_clave
DB_HOST=localhost
DB_PORT=5432

# ---------- Firebase (backend, escritorio y modelo) ----------
FIREBASE_PROJECT_ID=hackajal
FIREBASE_API_KEY=tu_apiKey_web_de_firebase

# ---------- Django ----------
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Dirección de la API (escritorio y modelo) ----------
API_URL=http://127.0.0.1:8000/api
# real = usa el backend y Firebase · mock = datos de prueba sin backend
HACKAJAL_MODE=real

# ---------- Portal web (Vite solo expone las variables que empiezan con VITE_) ----------
VITE_API_URL=http://127.0.0.1:8000/api

# ---------- Opcional: cuenta para correr modelo/codigo/cliente_api.py sin escribirla cada vez ----------
# USUARIO_EMAIL=
# USUARIO_PASSWORD=
