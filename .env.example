# ==============================================================================
# HACKAJAL - Configuración de Entorno
# ==============================================================================

# Modo de operación: "mock" (desarrollo y pruebas locales) o "real" (producción / backend Django + Firebase)
HACKAJAL_MODE=mock

# Configuración para Modo MOCK (por defecto en desarrollo):
MOCK_API_URL=http://127.0.0.1:8000/api

# Configuración para Modo REAL:
# API_URL=http://127.0.0.1:8000/api
# FIREBASE_API_KEY=tu-clave-web-de-firebase-aqui
# FIREBASE_LOGIN_URL=https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword

# Configuración general:
API_TIMEOUT_SECONDS=60
