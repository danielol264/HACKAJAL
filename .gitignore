# ==============================================================================
# HACKAJAL - Git Ignore Rules
# ==============================================================================

# Python & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
desktop/.venv/
desktop/.runtime/
desktop/.runtime-cache/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Build & Distribution Artifacts (Local only - do not version binaries)
build/
dist/
*.spec
*.manifest
HACKAJAL-Entrega/
HACKAJAL-Entrega.zip
*.zip
*.exe
*.msi

# Runtime Generated Resources
desktop/resources/maps/*.html

# Environment & Credentials (NEVER commit secrets)
.env
.env.local
.env.*.local
!.env.example

# Frontend (Node / Vite / React)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- Modelo ----------
# credenciales de servicio (nunca se suben)
*.json.key
*credenciales*.json
llave*.json
# copia del último archivo cargado desde la app de escritorio
modelo/datos/datos_semanales_cargados.csv
