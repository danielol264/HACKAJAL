# ==============================================================================
# PORTAL WEB HACKAJAL - Variables de Entorno (Vite + React)
# ==============================================================================

# URL base del servicio backend Django REST Framework.
# En desarrollo local: http://127.0.0.1:8000/api
# En producción: https://api.tudominio.gob.mx/api
VITE_API_URL=http://127.0.0.1:8000/api

# Modo de pruebas / datos simulados (true / false)
# Mantener en false para conectar al backend real de Django.
VITE_USE_MOCK=false
